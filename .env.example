# Copy to .env (gitignored) and fill in. `make backend` reads it; the app always uses the production database.
# Never commit .env. Deployment sets the same keys in the Render dashboard instead.

# Production RDS database (required). sslrootcert = your local copy of the RDS CA bundle.
CC_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/commandcenter_v2?sslmode=verify-full&sslrootcert=/path/to/rds-global-bundle.pem

# Production sign-in accounts (required): JSON from `python -m app.auth`, single-quoted so $ stays literal.
CC_USERS=
# 32+ random characters; must match production so tokens stay valid.
CC_AUTH_SECRET=

# Demo day: auto starts at the kit's 18:20 "now" and keeps running. Pause and +5 min on the Data page move this clock.
# For a frozen snapshot instead: CC_CLOCK_MODE=fixed and CC_CLOCK_FIXED=2026-03-17T18:20:00-04:00
CC_SERVICE_DATE=2026-03-17
CC_CLOCK_MODE=auto

# Text-to-speech for alerts and offers. Empty = audio routes answer 503 and the apps show the text.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional fixed role tokens (32+ random characters each). Empty = that token is off;
# password accounts still work.
CC_COORDINATOR_TOKEN=
CC_LEAD_TOKEN=
CC_ADMIN_TOKEN=
# Signs physician links from POST /admin/physician-tokens. Empty = no physician links.
CC_TOKEN_SECRET=

